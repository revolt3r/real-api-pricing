    "official": "First-party vendor pricing page read this round. High confidence.",
    "official_indirect": "First-party rate restated in vendor docs, announcement or console help because the pricing page itself is JS-rendered or gives no three-part split. Medium confidence.",
    "third_party": "Open-weight or wrapper-only model with no first-party rate card; a named gateway or tracker rate is recorded instead. Low confidence.",
    "unavailable": "No defensible public rate found. Prices stay null and the API cost column stays blank; no value is invented."
  },
  "conventions": {
    "unit": "USD per million tokens",
    "regionRule": "Where a vendor publishes both an international and a domestic-CNY list, the international USD list is recorded as the base, matching the existing qwen3.7-plus decision.",
    "promoRule": "Base fields hold the standing list price; promotional and speed/context variants stay in variants and are not used for the API cost column.",
    "cacheFallback": "cachedInput null means the vendor publishes no cache-read rate; compute.py falls back to 0.1x input, which is the multiplier every vendor that does publish one uses.",
    "blendRule": "The API cost column weights cachedInput/input/output by the project standard workload in conventions.json (97.5% / 2.15% / 0.35%). Cache writes are still not modeled, so API cost is a floor for providers that bill them."
  },
